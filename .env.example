# Copy this file to .env and adjust values for local development.
# Never commit .env.

# Ports
WEB_PORT=3000
API_PORT=4000
AI_PORT=8000
DATABASE_PORT=5432

# PostgreSQL (Docker Compose local prototype)
POSTGRES_USER=lmsmart
POSTGRES_PASSWORD=lmsmart
POSTGRES_DB=lmsmart
DATABASE_URL=postgresql://lmsmart:lmsmart@localhost:5432/lmsmart

# API
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=replace-with-at-least-16-chars
HMAC_SECRET=replace-with-at-least-16-chars

# File storage (local folders, not cloud)
STORAGE_PATH=./storage

# Phase 8 intelligence (FastAPI). Optional — owner workflow continues if this is down.
AI_URL=http://localhost:8000
AI_TIMEOUT_MS=20000

# Email mock (Phase 6). Leave blank until then.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
